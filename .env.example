# Base de dados (local: npm run db)
DATABASE_URL="postgresql://amizade:amizade@localhost:5433/amizade"

# URL público do site (usado nos emails de recuperação de password)
APP_URL="http://localhost:3000"

# Email (opcional em desenvolvimento: sem chave, o link aparece no terminal)
RESEND_API_KEY=""
EMAIL_FROM="Grupo Amizade <nao-responder@exemplo.pt>"

# Imagens (opcional em desenvolvimento: sem token, ficam em public/uploads)
BLOB_READ_WRITE_TOKEN=""

# Conta Master criada pelo seed (muda a password depois do primeiro login)
SEED_MASTER_EMAIL="master@grupoamizade.pt"
SEED_MASTER_PASSWORD=""

# Conteúdo de demonstração (só em desenvolvimento)
SEED_DEMO="false"
# Password das contas de demonstração (utilizador, jovem, staff, direcao), só com SEED_DEMO=true
SEED_DEMO_PASSWORD=""
